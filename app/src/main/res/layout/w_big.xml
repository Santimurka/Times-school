<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp">

        <TextView android:id="@+id/label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="9sp" android:letterSpacing="0.1" android:maxLines="1"/>

        <TextView android:id="@+id/title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textStyle="bold"
            android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="-2dp"/>

        <TextView android:id="@+id/sub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:maxLines="1" android:paddingTop="3dp"/>

        <TextView android:id="@+id/badge"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/>

        <TextView android:id="@+id/next"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="7dp"/>

        <TextView android:id="@+id/today"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="9sp" android:maxLines="1" android:paddingTop="2dp"/>
    </LinearLayout>
</FrameLayout>